# Production Environment Configuration for Multithreading

# Clustering Configuration
NODE_ENV=production
ENABLE_CLUSTERING=true

# Worker Configuration
# MAX_WORKERS controls how many worker processes to spawn
# If not set, it will use the number of CPU cores available
# Recommended: Set to number of CPU cores or slightly less for production
MAX_WORKERS=

# Database Configuration
# Prisma connection pool settings for production clustering
# These should be adjusted based on your database capacity and worker count
DATABASE_URL=""

# Connection Pool Settings (recommended for clustering)
# Total connections = MAX_WORKERS * CONNECTION_LIMIT per worker
# Example: 4 workers * 10 connections = 40 total connections
PRISMA_CONNECTION_LIMIT=10
PRISMA_TIMEOUT=20000

# Performance Settings
# Memory settings for each worker process
NODE_OPTIONS="--max-old-space-size=2048"

# Redis Configuration (if using Redis for session/cache)
REDIS_URL=""
REDIS_MAX_CONNECTIONS_PER_WORKER=5

# Monitoring and Health Check
HEALTH_CHECK_INTERVAL=30000
WORKER_RESTART_THRESHOLD=5
WORKER_RESTART_WINDOW=60000

# Security Settings
HELMET_ENABLED=true
RATE_LIMITING_ENABLED=true
COMPRESSION_ENABLED=true

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=combined

# Port Configuration
PORT=9000

# CORS Configuration
ALLOWED_ORIGINS="https://eksicode.org,https://www.eksicode.org,https://demo.eksicode.org"

# Email Service Configuration
EMAIL_SERVICE_ENABLED=true
EMAIL_POOL_SIZE=5

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_TIMEOUT=30000

# JWT Configuration
JWT_SECRET=""
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Additional Production Settings
TRUST_PROXY=true
KEEP_ALIVE_TIMEOUT=65000
HEADERS_TIMEOUT=66000
