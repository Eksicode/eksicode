{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node ./dist/server.js",
    "start:prod": "NODE_ENV=production ENABLE_CLUSTERING=true node ./dist/server.js",
    "start:dev": "NODE_ENV=development ENABLE_CLUSTERING=false node ./dist/server.js",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "watch": "nodemon --exec \"npm run build && npm run start:dev\" --watch src --ext ts",
    "build-win": "del dist /F /Q && tsc -p tsconfig.json",
    "watch-win": "nodemon --exec \"npm run build-win && npm run start:dev\" --watch src --ext ts",
    "seed": "npx tsx prisma/seeders/index.ts",
    "seed:dev": "NODE_ENV=development npx tsx prisma/seeders/index.ts",
    "seed:test": "npx tsx prisma/test-seeding-system.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seeders/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.5",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "tslib": "^2.8.1",
    "uuid": "^11.1.0",
    "zod": "^3.23.8"
  }
}
