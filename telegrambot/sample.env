# ============================================================================
# Telegram Bot Configuration - Production Environment
# ============================================================================

# ----------------------------------------------------------------------------
# Telegram Bot Settings
# ----------------------------------------------------------------------------
# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Admin channel ID for notifications and logs
ADMIN_CH_ID=-1001234567890

# ----------------------------------------------------------------------------
# Backend API Configuration
# ----------------------------------------------------------------------------
# Backend API endpoint (use Docker service name in production)
API_URL=http://backend:9000
# Or for development: API_URL=http://localhost:9000

# API Authentication
API_USER=your_api_username
API_PASS=your_api_password

# API timeout in milliseconds
API_TIMEOUT=30000

# ----------------------------------------------------------------------------
# Social Media & Community Links
# ----------------------------------------------------------------------------
DISCORD_URL=https://discord.gg/eksicode
YOUTUBE_URL=https://youtube.com/@eksicode
GITHUB_URL=https://github.com/eksicode
TWITTER_URL=https://twitter.com/eksicode
ANNOUNCEMENT_CHANNEL_URL=https://t.me/eksicode_announcements

# ----------------------------------------------------------------------------
# Redis Configuration (Queue & Cache)
# ----------------------------------------------------------------------------
# Redis connection settings (use Docker service name in production)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_DB=0

# Redis connection pool settings
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

# ----------------------------------------------------------------------------
# Queue Configuration (BullMQ)
# ----------------------------------------------------------------------------
# Enable queue processing
ENABLE_QUEUE=true

# Number of concurrent jobs to process
QUEUE_CONCURRENCY=10

# Maximum queue size
MAX_QUEUE_SIZE=1000

# Queue retry settings
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY=5000

# Job timeout (milliseconds)
QUEUE_JOB_TIMEOUT=60000

# ----------------------------------------------------------------------------
# Worker Thread Configuration
# ----------------------------------------------------------------------------
# Number of worker threads (recommended: 2-4 for production)
WORKER_THREADS=4

# PM2 instances (set to 1 for fork mode, or use cluster mode)
PM2_INSTANCES=1

# ----------------------------------------------------------------------------
# Webhook Configuration (Optional - for webhook mode instead of polling)
# ----------------------------------------------------------------------------
# Leave empty to use polling mode (default)
# TELEGRAM_WEBHOOK_URL=https://api-demo.eksicode.org/telegram/webhook
# TELEGRAM_WEBHOOK_PORT=8080
# TELEGRAM_WEBHOOK_PATH=/webhook

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------
# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# Maximum number of log files to keep
LOG_MAX_FILES=7

# Maximum log file size
LOG_MAX_SIZE=10485760

# ----------------------------------------------------------------------------
# Node.js Configuration
# ----------------------------------------------------------------------------
NODE_ENV=production

# Memory limit (in MB) - set via NODE_OPTIONS in docker-compose.yml
# NODE_OPTIONS=--max-old-space-size=1536

# Timezone
TZ=Europe/Istanbul

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
# Rate limit for messages per user (per minute)
RATE_LIMIT_PER_USER=20

# Rate limit window (milliseconds)
RATE_LIMIT_WINDOW=60000

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
# Enable debug mode (shows more detailed logs)
DEBUG_MODE=false

# Enable metrics collection
ENABLE_METRICS=true

# Enable health checks
ENABLE_HEALTH_CHECK=true